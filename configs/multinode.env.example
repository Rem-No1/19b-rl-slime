# Common values: source this file inside every node's Docker container.
MASTER_ADDR=10.0.0.10
ACTOR_NUM_NODES=2
ACTOR_NUM_GPUS_PER_NODE=8
GPUS_PER_NODE=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# Set NODE_IP separately on each node before starting its Ray process.
# NODE_IP=10.0.0.10

RAY_PORT=6379
RAY_DASHBOARD_PORT=8265
RAY_CLUSTER_MODE=existing

# Change this to the interface used for inter-node GPU traffic (for example ib0/bond0/eth0).
SOCKET_IFNAME=ib0

# Conservative 2x8 H100 candidate for this 40-layer Qwen3.5-MoE model.
TRAIN_TP=2
TRAIN_PP=2
TRAIN_CP=1
TRAIN_EP=2
ROLLOUT_TP=2

MODEL_PATH=/mnt/data/user01/19b100w/Qwen19B-100w
OUTPUT_ROOT=/mnt/data/user01/19b100w/slime_runs
